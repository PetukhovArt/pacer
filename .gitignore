/target

# berth-managed agent hook files installed at agent spawn
/.codex/
/.cursor/

# Everything under .claude is local — berth's generated settings, the
# worktrees it makes for sessions, scratch files. The exceptions are the
# project's own prompt hook and the settings file that registers it.
/.claude/*
!/.claude/hooks/
!/.claude/plans/
!/.claude/settings.json

# Personal, machine-local instructions — never committed
CLAUDE.local.md
design-screenshots/
.DS_Store

.idea

# generated npm release packages (npm/build-packages.mjs)
/npm/dist/

# Desktop app and web UI (apps/, packages/)
node_modules/
dist/
target/
/.stable-target/
packages/ui-tokens/generated/
apps/desktop/src-tauri/gen/
*.log
