{
  "palette": {
    "$type": "color",
    "indigo": {
      "50": { "$value": "#eef2ff" }, "100": { "$value": "#e0e7ff" }, "200": { "$value": "#c7d2fe" },
      "300": { "$value": "#a5b4fc" }, "400": { "$value": "#818cf8" }, "500": { "$value": "#6366f1" },
      "600": { "$value": "#4f46e5" }, "700": { "$value": "#4338ca" }, "800": { "$value": "#3730a3" },
      "900": { "$value": "#312e81" }, "950": { "$value": "#1e1b4b" }
    },
    "slate": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f8fafc" }, "100": { "$value": "#f1f5f9" }, "200": { "$value": "#e2e8f0" },
      "300": { "$value": "#cbd5e1" }, "400": { "$value": "#94a3b8" }, "500": { "$value": "#64748b" },
      "600": { "$value": "#475569" }, "700": { "$value": "#334155" }, "800": { "$value": "#1e293b" },
      "900": { "$value": "#0f172a" }, "950": { "$value": "#020617" }
    },
    "green": { "500": { "$value": "#22c55e" } },
    "amber": { "500": { "$value": "#f59e0b" } },
    "red": { "500": { "$value": "#ef4444" } },
    "sky": { "500": { "$value": "#0ea5e9" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "6": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" }, "md": { "$value": "8px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Inter, 'Segoe UI', system-ui, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', Consolas, monospace" }
  }
}
