{
  "name": "berth-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter @berth/web dev",
    "dev:desktop": "pnpm --filter @berth/desktop dev",
    "build:tokens": "pnpm --filter @ui/tokens build",
    "build:desktop": "pnpm build:tokens && pnpm --filter @berth/desktop build",
    "lint": "oxlint --deny-warnings apps packages scripts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
}
