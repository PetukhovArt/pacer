{
  "name": "veyra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:server": "pnpm --filter @veyra/server dev",
    "dev:web": "pnpm --filter @veyra/web dev",
    "dev:desktop": "pnpm --filter @veyra/desktop dev",
    "dev:relay": "node scripts/dev-relay.mjs",
    "runner": "pnpm --filter @veyra/runner start",
    "build:tokens": "pnpm --filter @ui/tokens build",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "verify": "pnpm build:tokens && pnpm typecheck",
    "lint": "oxlint --deny-warnings",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "fastify": "^5.12.7",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
}