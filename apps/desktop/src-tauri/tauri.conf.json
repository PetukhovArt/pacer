{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Berth",
  "version": "0.0.0",
  "identifier": "dev.berth.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5196",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @berth/web dev --port 5196 --strictPort --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @berth/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Berth",
        "width": 1400,
        "height": 900,
        "decorations": false,
        "focus": false,
        "visible": false,
        "backgroundColor": "#2a2d1c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
